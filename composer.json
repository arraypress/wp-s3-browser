{
  "name": "arraypress/wp-s3-browser",
  "description": "A comprehensive PHP library for integrating S3-compatible storage providers with WordPress. Features advanced media browser, upload/download management, presigned URLs, and support for multiple providers including AWS S3, Cloudflare R2, DigitalOcean Spaces, and more.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-s3-browser/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "arraypress/wp-breadcrumbs": "^1.1",
    "arraypress/wp-composer-assets": "^2.2",
    "arraypress/wp-s3-signer": "^1.2",
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\S3\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-s3-browser/issues",
    "source": "https://github.com/arraypress/wp-s3-browser"
  },
  "keywords": [
    "s3",
    "aws",
    "aws-s3",
    "cloudflare-r2",
    "digitalocean-spaces",
    "linode-object-storage",
    "vultr-object-storage",
    "minio",
    "object-storage",
    "cloud-storage",
    "file-storage",
    "media-browser",
    "wordpress",
    "wp-plugin",
    "file-upload",
    "file-download",
    "presigned-urls",
    "s3-compatible",
    "storage-provider",
    "bucket-management",
    "object-management",
    "cdn",
    "file-hosting",
    "backup-storage"
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\S3\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "format": "phpcbf --standard=phpcs-format.xml.dist src",
    "format:check": "phpcs --standard=phpcs-format.xml.dist src"
  }
}
